# KrathongScanner Environment Configuration
# Copy this file to .env and update the values as needed

# Application Settings
APP_NAME=KrathongScanner
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ArUco Detection Settings
ARUCO_DICT_TYPE=4X4_50
ARUCO_MARKER_SIZE=0.04
ARUCO_MARKER_SEPARATION=0.01
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# WebSocket API Settings
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8765
WEBSOCKET_MAX_CONNECTIONS=10
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Unity Integration Settings
UNITY_CLIENT_TIMEOUT=60
UNITY_MAX_RECONNECT_ATTEMPTS=5

# Logging
LOG_FILE=logs/krathong_scanner.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Performance Settings
DETECTION_INTERVAL=0.033  # 30 FPS
POSE_ESTIMATION_ENABLED=true
MULTI_MARKER_DETECTION=true

# Development Settings
ENABLE_HOT_RELOAD=false
ENABLE_PROFILING=false
ENABLE_METRICS=false
